name: TikTok 地区解锁（日本）
desc: |-
  通用改写方案，只对旧版 TikTok（约 21.1.0）稳定有效
  新版 TikTok 会校验请求签名，改参数反而可能导致无法播放
  需开启 MITM 并信任证书，TikTok 分流到日本节点
icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/TikTok.png
category: 解锁

http:
  mitm:
    - "*.tiktokv.com"
    - "*.byteoversea.com"
    - "*.tik-tokapi.com"
  rewrite:
    # JP 为观看地区，可改为 US / TW / KR / SG
    - (?<=_region=)CN(?=&) JP 307
    - (?<=&mcc_mnc=)4 2 307
    - ^(https?:\/\/(tnc|dm)[\w-]+\.\w+\.com\/.+)(\?)(.+) $1$3 302
    - (^https?:\/\/*\.\w{4}okv.com\/.+&.+)(\d{2}\.3\.\d)(.+) $118.0$3 302
